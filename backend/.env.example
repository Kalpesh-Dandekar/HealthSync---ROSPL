# Required: local PostgreSQL connection. Replace YOUR_PASSWORD locally.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/healthsync_dev"

# Required: generate a unique random value of at least 32 characters.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Optional application settings
PORT=5000
CLIENT_ORIGIN="http://localhost:5175"

# Optional local Ollama integration. The backend has a non-AI fallback.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
