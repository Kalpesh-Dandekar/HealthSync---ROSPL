% HealthSync ASP appointment scheduler - based on the supplied research paper.
% Facts are generated by the Node API from current requests, availability and preferences.

% HARD CONSTRAINTS
:- selected(P,C,D,V,T), occupied(C,D,T).
:- selected(P,C,D,V,T), needs_accessibility(P), not accessible(C).
:- selected(P,C,D,V,T), in_person(V), clinic_mode(C,telemedicine).

% SOFT OBJECTIVES: wait time, distance, sensory mismatch, clinic/doctor preference.
#minimize {
  W@1,P,C,D,V,T : selected(P,C,D,V,T), wait(P,T,W);
  Dist*10@2,P,C,D,V,T : selected(P,C,D,V,T), distance(P,C,Dist);
  Pen*100@3,P,C,D,V,T : selected(P,C,D,V,T), sensory_penalty(P,C,T,Pen);
  10000@4,P,C,D,V,T : selected(P,C,D,V,T), clinic_preference(P,C,0);
  1000@5,P,C,D,V,T : selected(P,C,D,V,T), doctor_preference(P,D,0)
}.

% High urgency requests are not allowed behind lower urgency requests.
:- selected(P1,_,_,_,T1), selected(P2,_,_,_,T2), urgency(P1,U1), urgency(P2,U2), U1>U2, T1>T2.

% Exactly one feasible slot per request.
1 { selected(P,C,D,V,T) : availability(C,D,V,T) } 1 :- request(P,V).

% Preference scoring.
clinic_preference(P,C,1) :- preferred_clinic(P,C).
clinic_preference(P,C,0) :- request(P,_), clinic(C), not preferred_clinic(P,C).
doctor_preference(P,D,1) :- preferred_doctor(P,D).
doctor_preference(P,D,0) :- request(P,_), doctor(D), not preferred_doctor(P,D).
wait(P,T,W) :- requested_after(P,R), W=T-R, W>=0.
sensory_penalty(P,C,T,1) :- sensory_preference(P,S), environment_condition(C,S,bad,T).
sensory_penalty(P,C,T,0) :- selected(P,C,_,_,T), not sensory_preference(P,_).

#show selected/5.
